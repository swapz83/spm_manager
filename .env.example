# ServiceNow SPM Connection
# If SN_INSTANCE, SN_USER_TOKEN, and SN_USER_EMAIL are all set,
# the app fetches live data from ServiceNow.
# If any are missing, mock seed data is used instead.

# Your ServiceNow instance URL (no trailing slash)
SN_INSTANCE=https://yourcompany.service-now.com

# CSRF token (g_ck) from your browser session
SN_USER_TOKEN=your_g_ck_token_here

# Your email address in ServiceNow — used to look up your user record
# and fetch your direct reports
SN_USER_EMAIL=your.email@company.com

# ── Browser session cookie (dev-only, ~1 hour lifespan) ───────────────
# Paste the full Cookie header value from your browser's DevTools:
#   Network tab → pick any request to your SN instance → Headers → Cookie
# It will contain JSESSIONID, glide_session_store, glide_user_route, etc.
SN_COOKIE=
